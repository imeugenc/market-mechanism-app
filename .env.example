# Supabase Project URL
# Dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase public anon key
# Dashboard -> Project Settings -> API -> anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public origin only. Server credentials stay in the Journal's Vercel environment.
EXPO_PUBLIC_JOURNAL_API_URL=https://edge.marketmechanism.xyz
