{
  "expo": {
    "name": "Execution Edge",
    "slug": "execution-edge",
    "scheme": "executionedge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-image-picker",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.executionedge.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.executionedge.app"
    },
    "extra": {
      "router": {},
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "2c60e79f-90bb-42f5-b39e-4975213bea6e"
      }
    }
  }
}
