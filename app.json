{
  "expo": {
    "name": "Market Mechanism",
    "slug": "execution-edge",
    "description": "Market Mechanism web and mobile app for daily market analysis, personal requests, and premium trading content.",
    "scheme": "executionedge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./ios/ExecutionEdge/Images.xcassets/AppIcon.appiconset/App-Icon-1024x1024@1x.png",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-image-picker",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/market-mechanism-mark.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.executionedge.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.executionedge.app"
    },
    "extra": {
      "router": {},
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "2c60e79f-90bb-42f5-b39e-4975213bea6e"
      }
    }
  }
}
